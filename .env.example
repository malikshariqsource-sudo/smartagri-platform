# Keep a long random secret in production (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: enables live OpenAI responses for the farm assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Weather is public Open-Meteo API; no key is needed.
# Optional Postgres connection for production. When set, Postgres is used instead of SQLite.
DATABASE_URL=postgresql://user:password@host:5432/smartagri?sslmode=require
# SQLite file path for local development when DATABASE_URL is unset.
DATABASE_PATH=./data/smartagri.db
