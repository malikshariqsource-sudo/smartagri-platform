# Keep a long random secret in production (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: enables live OpenAI responses for the farm assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Weather is public Open-Meteo API; no key is needed.
# SQLite file path for local use. For Vercel, attach persistent Postgres and implement DATABASE_URL adapter.
DATABASE_PATH=./data/smartagri.db
